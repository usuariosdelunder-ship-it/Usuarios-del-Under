---
const today = new Date();
---

<footer>
    &copy; {today.getFullYear()} Usuarios del Under. Todos los derechos reservados.
    <div class="social-links">
      <!-- Icono de Instagram -->
      <a href="https://instagram.com/tu-usuario" target="_blank" rel="noopener noreferrer">
        <span class="sr-only">Síguenos en Instagram</span>
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>

      <!-- Icono de YouTube -->
      <a href="https://youtube.com/c/tu-canal" target="_blank" rel="noopener noreferrer">
        <span class="sr-only">Suscríbete en YouTube</span>
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33 2.78 2.78 0 0 0 1.94 2c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33z"></path>
          <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
        </svg>
      </a>

      <!-- Icono de Correo Electrónico -->
      <a href="mailto:tu-correo@ejemplo.com">
        <span class="sr-only">Envíanos un correo</span>
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
      </a>

	  <!-- Icono de Radio -->
      <a href="https://www.unm.edu.ar/ciudad-unm-radio-fm-88-7/" target="_blank" rel="noopener noreferrer">
        <span class="sr-only">Escucha nuestro programa de radio</span>
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
          <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
          <line x1="12" y1="19" x2="12" y2="22"></line>
        </svg>
      </a>
    </div>
</footer>
<style>
    footer {
        padding: 2em 1em 6em 1em;
        background-color: var(--bg-color); /* Fondo negro puro */
        color: var(--gray-dark); /* Texto blanco */
        text-align: center;
    }
    .social-links {
        display: flex;
        justify-content: center;
        gap: 1em;
        margin-top: 1em;
    }
    .social-links a {
        text-decoration: none;
        color: var(--gray-dark); /* Iconos en color blanco */
    }
    .social-links a:hover {
        color: var(--accent-red); /* Cambian a rojo intenso al pasar el cursor */
    }
</style>
