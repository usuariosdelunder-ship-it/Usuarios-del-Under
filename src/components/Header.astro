---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">Usuarios del Under</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Inicio</HeaderLink>
			<HeaderLink href="/blog">Actualidad</HeaderLink>
			<HeaderLink href="/agenda">Agenda</HeaderLink>
			<HeaderLink href="/discos">Discos</HeaderLink>
			<HeaderLink href="/playlists">Playlists</HeaderLink>
			<HeaderLink href="/comunidad">Comunidad</HeaderLink>
		</div>
<div class="social-links">
  <!-- Icono de Instagram -->
  <a href="https://www.instagram.com/usuariosdelunder/" target="_blank" rel="noopener noreferrer">
    <span class="sr-only">Síguenos en Instagram</span>
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
    </svg>
  </a>

  <!-- Icono de YouTube -->
  <a href="https://www.youtube.com/@UsuariosDelUnder" target="_blank" rel="noopener noreferrer">
    <span class="sr-only">Suscríbete en YouTube</span>
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33 2.78 2.78 0 0 0 1.94 2c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33z"></path>
      <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
    </svg>
  </a>

  <!-- Icono de Correo Electrónico -->
  <a href="mailto:usuariosdelunder@gmail.com">
    <span class="sr-only">Envíanos un correo</span>
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
      <polyline points="22,6 12,13 2,6"></polyline>
    </svg>
  </a>
</div>	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		/* Usamos la variable de tu degradé que creamos en global.css */
		background: var(--under-gradient);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: #000000; /* Título en negro puro */
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: #000000; /* Texto en negro puro */
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent-red); /* Subrayado rojo sangre */
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
